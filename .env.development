# Dev runs against the REAL backend.
#
# The mock backend only knows three invented accounts, so signing in with a real
# admin address against it fails with "not recognised" — which is exactly the
# confusion this default avoids. Real API, real credentials, real behaviour.
#
# To work offline against seeded data instead, create `.env.local` with
# VITE_USE_MOCKS=true (it is git-ignored and overrides this file).
VITE_API_BASE_URL=https://api.callschat.com
VITE_ENV_LABEL=development
VITE_USE_MOCKS=false
