# Environment for the automated test run (Vitest loads `.env.test` in test mode).
#
# Committed on purpose. Until now the unit tests picked these values up from
# `.env.local`, which is git-ignored — so the suite passed locally and would
# have failed on a fresh clone or in CI. Tests get their own deterministic
# environment and never depend on a developer's machine.
VITE_API_BASE_URL=http://localhost:4000
VITE_ENV_LABEL=local
VITE_USE_MOCKS=true
