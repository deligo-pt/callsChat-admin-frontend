# The TEST backend. `npm run dev:staging` / `npm run build:staging`.
#
# Committed on purpose, for the same reason as `.env.test`: it holds no secrets,
# only a public base URL and a label, and the whole point is that the team
# points at the same second target rather than each keeping a private
# `.env.local`.
#
# ⚠️ `.env.development` points at the PRODUCTION API. That is the default, and
# it is why this file exists: a second target has to be a deliberate choice with
# a visible consequence, never something you might already be on without
# noticing.
#
# `VITE_ENV_LABEL=staging` paints the top-bar badge amber — `TopBar.tsx` calls
# it "loud on staging so it is never mistaken for production". With two
# backends reachable from one codebase, that badge stops being decoration and
# becomes the only thing telling an operator whose data they are about to
# change.
VITE_API_BASE_URL=https://test-api.callschat.com
VITE_ENV_LABEL=staging
VITE_USE_MOCKS=false
