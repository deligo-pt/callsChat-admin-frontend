# CallChat Admin Panel — environment contract (validated in src/env.ts)
#
# Only browser-safe VITE_-prefixed values belong here.
# NEVER add backend secrets, payment provider keys, or database credentials.

# Base URL of the existing Node.js backend (no trailing slash, no /api/v1 suffix)
VITE_API_BASE_URL=http://localhost:4000

# local | development | staging | production — drives the top-bar environment badge
VITE_ENV_LABEL=local

# true  = boot the MSW mock backend (no real API required)
# false = call the real backend at VITE_API_BASE_URL
VITE_USE_MOCKS=true

# Optional release identifier surfaced in error reports
# VITE_RELEASE=
